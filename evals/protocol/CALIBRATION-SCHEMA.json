{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Convergence Guard comparative eval calibration answer",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "probabilities"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "probabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "p"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "p": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
